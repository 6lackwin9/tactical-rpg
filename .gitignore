# Godot 4+ specific ignores
.godot/
/android/

# Godot export binaries & packages
# (root-level exports only to preserve addon binaries)
/*.apk
/*.aab
/*.pck
/*.zip
/build/

# Godot logs and crashes
crash*.log
*.log

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and editor files
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*~

# Test outputs
test_*.txt

# Agent run checkpoints (resumable runs)
.agent/

# run.bat opt: branch the -opt worktree was opened from
.opt_branch

# Rust build output when CARGO_TARGET_DIR points inside the checkout (CI, the cloud hook)
/target/

__pycache__/
# Build folders a review or a cargo run inside a worktree can leave (2026-10-29: two were committed by `git add -A`)
/target-*/
/engine/target/
**/target/

# The Antigravity image queue (ARTQUEUE1): requests, generated images and results, in the main checkout only
.image_pipeline/

# The web build (tools/fc.sh web, WEBREL1-G1)
/out/
