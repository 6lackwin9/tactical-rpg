# Godot 4+ specific ignores
.godot/
/android/

# Godot export binaries & packages
# (root-level exports only to preserve addon binaries)
/*.apk
/*.aab
/*.pck
/*.zip
/build/

# Godot logs and crashes
crash*.log
*.log

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and editor files
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*~

# Test outputs
test_*.txt

# Agent run checkpoints (resumable runs)
.agent/

# run.bat opt: branch the -opt worktree was opened from
.opt_branch

# Rust build output when CARGO_TARGET_DIR points inside the checkout (CI, the cloud hook)
/target/

# Art session source images (large; the finished portraits are committed, not the sources)
art_src/
