      "entry": {
        "id": "dlg_cit_pawnbroker",
        "nodes": [
          {
            "id": "n0",
            "text": "The pawnbroker weighs a tin spoon on a brass scale. \"Spoons, shoes, a good tooth. Nothing from the cages; that's the Proctor's trade, not mine.\"",
            "choices": [
              {
                "text": "What do you sell?",
                "to": "no_trade"
              },
              {
                "text": "Ask for more.",
                "to": "more"
              },
              {
                "text": "Leave.",
                "to": ""
              }
            ]
          },
          {
            "id": "no_trade",
            "text": "\"I lend, I don't sell. Every spoon on that shelf has an owner still coming back for it.\"",
            "next": "n0"
          },
          {
            "id": "more",
            "text": "\"Nobody pawns a name. They'd get more for it.\"",
            "choices": [
              {
                "text": "Leave.",
                "to": ""
              }
            ]
          }
        ]
      }
    },
    {
      "op": "upsert",
      "kind": "dialogues",
      "world": "sunk_ward",
      "fields": [
        "nodes"
      ],
      "entry": {
        "id": "dlg_cit_lodging",
        "nodes": [
          {
            "id": "n0",
            "text": "A lodging-keeper counts coins into a tin without looking at them. \"Beds by the night, none by the week. Nobody who sleeps here is here in the morning.\"",
            "choices": [
              {
                "text": "What do you sell?",
                "to": "no_trade"
              },
              {
                "text": "Ask for more.",
                "to": "more"
              },
              {
                "text": "Leave.",
                "to": ""
              }
            ]
          },
          {
            "id": "no_trade",
            "text": "\"Beds, not wares. And the beds are full, for faces like yours.\"",
            "next": "n0"
          },
          {
            "id": "more",
            "text": "\"Quiet house. Keep it quiet.\"",
            "choices": [
              {
                "text": "Leave.",
                "to": ""
              }
            ]
          }
        ]
      }
    },
    {
      "op": "upsert",
      "kind": "dialogues",
      "world": "sunk_ward",
      "fields": [
        "nodes"
      ],
      "entry": {
        "id": "dlg_skerrit",
        "nodes": [
          {
            "id": "n0",
            "text": "A hunchbacked figure mutters over a bench of calcified shards, forging a seal onto a strip of bone. \"Mind the dust. It bites.\"",
            "choices": [
              {
                "text": "What do you sell?",
                "to": "no_trade",
                "unless": [
                  {
                    "key": "sunk_ward.skerrit_open",
                    "value": true
                  }
                ]
              },
              {
                "text": "What do you make?",
                "to": "make"
              },
              {
                "text": "Dunstan sent me. Chain-gang wedges.",
                "to": "wedges",
                "requires": [
                  {
                    "key": "sunk_ward.wedges_done",
                    "value": true
                  }
                ],
                "unless": [
                  {
                    "key": "sunk_ward.skerrit_open",
                    "value": true
                  }
                ]
              }
            ]
          },
          {
            "id": "no_trade",
            "text": "\"Sell? I make, and not for strangers. Somebody I trust vouches for you first.\"",
            "next": "n0"
          },
          {
            "id": "make",
            "text": "\"Quarrels that open mail. Cestuses with barbs for the knuckles. Bone is dull, bone is honest, bone doesn't dream. Bring shards and a cause.\"",
            "next": "n0"
          },
          {
            "id": "wedges",
            "text": "\"Black-iron wedges from the Fourth Kiln. Heavy enough to split a mould and fine enough to cut a cestus. Tell the big fellow I owe him. Tell Berek I owe him more.\"",
            "next": "n0",
            "effects": [
              {
                "effect": "set_flag",
                "key": "sunk_ward.skerrit_open",
                "value": true
              }
            ]
          }
        ]
      }
    }
  ]
