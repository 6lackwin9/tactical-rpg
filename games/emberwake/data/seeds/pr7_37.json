  {
   "op": "upsert",
   "kind": "dialogues",
   "world": "sunk_ward",
   "entry": {
    "id": "dlg_varka",
    "name": "Widow Varka at the Leaking Vat",
    "speaker": "widow_varka",
    "start": "n0",
    "nodes": [
     {
      "id": "n0",
      "text": "Behind a veil of waxed black crepe, Widow Varka lays a pair of brass salt-scales on the sluice rail. \"Everything has a price, dear. Mine are fair, and so is my memory.\"",
      "choices": [
       {
        "text": "What do you sell?",
        "to": "stock",
        "requires": [
         {
          "key": "sunk_ward.ivo_rescued",
          "value": true
         }
        ],
        "effects": [
         {
          "effect": "open_shop",
          "shop": "varka_trade"
         }
        ]
       },
       {
        "text": "What do you sell?",
        "to": "stock_shut",
        "unless": [
         {
          "key": "sunk_ward.ivo_rescued",
          "value": true
         }
        ]
       },
       {
        "text": "Why open the Basin to us?",
        "to": "ivo",
        "requires": [
         {
          "key": "sunk_ward.ivo_rescued",
          "value": true
         }
        ],
        "unless": [
         {
          "key": "sunk_ward.varka_ivo_told",
          "value": true
         }
        ]
       }
      ]
     },
     {
      "id": "stock",
      "text": "\"Rock Salt. Warded Tallow, by the day. Poultices. Whatever the Clerisy has sworn is not for sale, and is. I do not ask what you intend to burn.\"",
      "next": "n0"
     },
     {
      "id": "stock_shut",
      "text": "She does not lift the veil. \"To you? Nothing yet, dear. My shelves open for friends of the Basin, and the Basin has not yet decided what you are.\"",
      "next": "n0"
     },
     {
      "id": "ivo",
      "text": "\"The boy ran my messages before Talia hid him. A woman remembers who feeds a child. The Basin trades with whoever brought him home. That is all the sentiment I can afford.\"",
      "next": "n0",
      "effects": [
       {
        "effect": "set_flag",
        "key": "sunk_ward.varka_ivo_told",
        "value": true
       }
      ]
     }
    ],
    "services": true,
    "tags": []
   }
  }
 ]
