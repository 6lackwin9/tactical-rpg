    "name": "Candle-Maker (chandler) [PROVISIONAL]",
    "speaker": "cit_chandler",
    "start": "n0",
    "nodes": [
     {
      "id": "n0",
      "text": "The candle-maker keeps one eye on the window. \"Tallow's dear. Warded tallow is dearer, and I have it, five Scrap the cake.\" The wicks hang in rows like pale ribs.",
      "choices": [
       {
        "text": "Buy Warded Tallow.",
        "to": "stock",
        "effects": [
         {
          "effect": "open_shop",
          "shop": "chandler_stall"
         }
        ]
       },
       {
        "text": "Ask for more.",
        "to": "more"
       },
       {
        "text": "Leave.",
        "to": ""
       }
      ]
     },
     {
      "id": "more",
      "text": "\"The Watch buy by the dozen, never by the pound. Ask yourself why.\"",
      "choices": [
       {
        "text": "Leave.",
        "to": ""
       }
      ]
     },
     {
      "id": "stock",
      "text": "\"Keep it dry and keep it lit. The wards only hold while it burns.\"",
      "choices": [
       {
        "text": "Leave.",
        "to": ""
       }
      ]
     }
    ],
    "services": false,
    "tags": [
     "provisional",
     "ambient"
    ]
   }
