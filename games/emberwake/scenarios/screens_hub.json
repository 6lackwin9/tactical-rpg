{
  "id": "screens_hub",
  "title": "PR7-4: the hub screens as shots (golden once the baselines are approved) from a save at the hub: region map, talk box, notice board, shop, party, world map",
  "launch": {"save": "hub_start"},
  "settings": {"reduce_motion": true},
  "timeout_s": 300,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 20000},
    {"step": "wait", "until": {"widget": "bunk.bunk_1"}},
    {"step": "shot", "name": "region_map"},
    {"step": "perf", "name": "region_map", "frames": 60, "warm": 10},
    {"step": "click", "id": "marker.talia"},
    {"step": "wait", "until": {"all": [{"path": "state.walking", "eq": false}, {"path": "state.dialogue.speaker_name", "eq": "Talia Rusk"}]}, "timeout_ms": 30000},
    {"step": "shot", "name": "talk_box"},
    {"step": "click", "id": "choice.3"},
    {"step": "wait", "until": {"widget": "board.close"}},
    {"step": "shot", "name": "notice_board"},
    {"step": "click", "id": "board.close"},
    {"step": "repeat", "times": 5, "until": {"path": "state.dialogue", "absent": true}, "steps": [{"step": "key", "key": "esc"}]},
    {"step": "click", "id": "marker.sabina"},
    {"step": "wait", "until": {"all": [{"path": "state.walking", "eq": false}, {"path": "state.dialogue.speaker_name", "eq": "Chirurgeon Sabina"}]}, "timeout_ms": 30000},
    {"step": "click", "id": "choice.2"},
    {"step": "wait", "until": {"path": "state.shop", "ne": null}},
    {"step": "shot", "name": "shop"},
    {"step": "key", "key": "esc"},
    {"step": "repeat", "times": 5, "until": {"path": "state.dialogue", "absent": true}, "steps": [{"step": "key", "key": "esc"}]},
    {"step": "click", "id": "hud.party"},
    {"step": "wait", "until": {"path": "screen", "eq": "character"}},
    {"step": "shot", "name": "party_stats"},
    {"step": "click", "id": "character.tab.skills"},
    {"step": "shot", "name": "party_skills"},
    {"step": "click", "id": "character.tab.gear"},
    {"step": "shot", "name": "party_gear"},
    {"step": "key", "key": "esc"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}},
    {"step": "click", "id": "marker.road"},
    {"step": "wait", "until": {"path": "screen", "eq": "world_map"}, "timeout_ms": 30000},
    {"step": "shot", "name": "world_map"}
  ]
}
