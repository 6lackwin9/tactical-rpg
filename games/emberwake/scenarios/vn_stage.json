{
  "id": "vn_stage",
  "title": "PR7-27 (VNSTAGE1): the prologue's story stage: Kaelen enters left on a scrolling backdrop, the narration keeps the scene dimmed while he exits right, the Log and Auto; the mortuary cart's pan with the party walking in and the captives pinned right",
  "timeout_s": 600,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.new_game"},
    {"step": "wait", "until": {"widget": "world.sunk_ward"}},
    {"step": "click", "id": "world.sunk_ward"},
    {"step": "click", "id": "new_game.start"},
    {"step": "wait", "until": {"path": "screen", "eq": "vignette"}, "timeout_ms": 20000},
    {"step": "repeat", "times": 40, "until": {"path": "screen", "ne": "vignette"}, "steps": [{"step": "key", "key": "space"}]},
    {"step": "wait", "until": {"path": "screen", "eq": "battle"}, "timeout_ms": 20000},
    {"step": "wait", "until": {"path": "state.beat", "absent": true}, "timeout_ms": 10000},
    {"step": "link", "body": {"cmd": "autoplay"}},
    {"step": "repeat", "times": 15, "until": {"path": "screen", "eq": "battle_results"}, "steps": [{"step": "pause", "ms": 400}, {"step": "key", "key": "enter"}]},
    {"step": "click", "id": "results.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "vignette"}, "timeout_ms": 20000},
    {"step": "assert", "until": {"path": "state.view.fields.camera.text", "eq": "scroll"}},
    {"step": "shot", "name": "a_enter_scroll_start", "t": 0.4},
    {"step": "shot", "name": "b_enter_scroll_end", "t": 4.0},
    {"step": "repeat", "times": 12, "until": {"path": "state.view.fields.style.text", "eq": "text"}, "steps": [{"step": "key", "key": "space"}]},
    {"step": "assert", "until": {"path": "state.view.fields.dimmed.flag", "eq": true}},
    {"step": "pause", "ms": 800},
    {"step": "shot", "name": "c_narration_dimmed_exit"},
    {"step": "click", "id": "vignette.log"},
    {"step": "assert", "until": {"path": "state.log_open", "eq": true}},
    {"step": "shot", "name": "d_log"},
    {"step": "click", "id": "vignette.log.close"},
    {"step": "click", "id": "vignette.auto"},
    {"step": "assert", "until": {"path": "state.auto", "eq": true}},
    {"step": "repeat", "times": 40, "until": {"path": "screen", "ne": "vignette"}, "steps": [{"step": "key", "key": "space"}]},
    {"step": "wait", "until": {"path": "screen", "eq": "battle"}, "timeout_ms": 20000},
    {"step": "wait", "until": {"path": "state.beat", "absent": true}, "timeout_ms": 10000},
    {"step": "link", "body": {"cmd": "autoplay"}},
    {"step": "repeat", "times": 15, "until": {"path": "screen", "eq": "battle_results"}, "steps": [{"step": "pause", "ms": 400}, {"step": "key", "key": "enter"}]},
    {"step": "click", "id": "results.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "vignette"}, "timeout_ms": 20000},
    {"step": "assert", "until": {"path": "state.view.fields.camera.text", "eq": "pan"}},
    {"step": "shot", "name": "e_pan_party_enters", "t": 2.0},
    {"step": "shot", "name": "f_pan_end", "t": 5.0},
    {"step": "repeat", "times": 30, "until": {"path": "state.view.fields.speaker.text", "eq": "Hollis"}, "steps": [{"step": "key", "key": "space"}]},
    {"step": "pause", "ms": 400},
    {"step": "shot", "name": "g_line_four_actors"},
    {"step": "repeat", "times": 12, "until": {"path": "state.view.fields.style.text", "eq": "text"}, "steps": [{"step": "key", "key": "space"}]},
    {"step": "pause", "ms": 800},
    {"step": "shot", "name": "h_all_exit_right"}
  ]
}
