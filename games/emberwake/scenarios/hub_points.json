{
  "id": "hub_points",
  "title": "PR7-37 (PT-03, PT-29): the playtest save hub_start; a click on the cold vaults and the coke-brazier walks there (beside the vaults, walled off) and each answers in the log; E on the brazier rests or says why not; PR7-51 (FOOTLOCKER1): Maren's footlocker opens her loadout over the shared stash (the open art behind it) and closes with it; PR7-58 (FOOTLOCKER1B): it shows open on the map for a beat before the loadout comes up; Widow Varka's What do you sell? says her shelves are shut until Ivo is home",
  "launch": {"save": "hub_start"},
  "settings": {"reduce_motion": true},
  "timeout_s": 300,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 20000},
    {"step": "pause", "ms": 1000},
    {"step": "click", "id": "marker.crypts"},
    {"step": "wait", "until": {"path": "state.walking", "eq": false}, "timeout_ms": 15000},
    {"step": "pause", "ms": 600},
    {"step": "assert", "until": {"path": "state.log", "has": "The cold vaults: Slate mortuary tables under iron bars. Nobody sleeps down in this wing."}},
    {"step": "shot", "name": "hub_cold_vaults"},
    {"step": "click", "id": "marker.rest"},
    {"step": "wait", "until": {"path": "state.walking", "eq": false}, "timeout_ms": 15000},
    {"step": "pause", "ms": 600},
    {"step": "assert", "until": {"path": "state.log", "has": "The hall coke-brazier: Low anthracite embers in a cast pan, keeping the basin damp off the Hall slabs."}},
    {"step": "key", "key": "e"},
    {"step": "pause", "ms": 600},
    {"step": "shot", "name": "hub_brazier_rest"},
    {"step": "click", "id": "locker.maren"},
    {"step": "assert", "until": {"all": [{"path": "screen", "eq": "region_map"}, {"path": "state.locker_open", "eq": "maren"}]}},
    {"step": "wait", "until": {"path": "screen", "eq": "character"}, "timeout_ms": 15000},
    {"step": "pause", "ms": 600},
    {"step": "shot", "name": "hub_footlocker_open"},
    {"step": "key", "key": "escape"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 5000},
    {"step": "pause", "ms": 600},
    {"step": "assert", "until": {"path": "state.locker_open", "eq": ""}},
    {"step": "shot", "name": "hub_footlocker_closed"},
    {"step": "click", "id": "marker.varka"},
    {"step": "wait", "until": {"path": "state.dialogue.text", "ne": ""}, "timeout_ms": 15000},
    {"step": "pause", "ms": 600},
    {"step": "click", "id": "choice.0"},
    {"step": "pause", "ms": 800},
    {"step": "assert", "until": {"path": "state.dialogue.text", "has": "Nothing yet"}},
    {"step": "shot", "name": "hub_varka_shut"}
  ]
}
