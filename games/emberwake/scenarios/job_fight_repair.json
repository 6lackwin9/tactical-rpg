{
  "id": "job_fight_repair",
  "title": "PR7-41 (PT-15): the playtest save m3_stuck (The Bone-Mill Raid won before it was taken) loads repaired: the job is ready to turn in, the party travels to the hub and Talia takes it",
  "launch": {"save": "m3_stuck"},
  "settings": {"reduce_motion": true},
  "timeout_s": 600,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "notice"}, "timeout_ms": 20000},
    {"step": "shot", "name": "repair_notice"},
    {"step": "click", "id": "notice.ok"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 20000},
    {"step": "assert", "until": {"path": "state.location", "eq": "sunk_ward:fourth_kiln"}},
    {"step": "assert", "until": {"path": "state.quests.sunk_ward:q_a1_m3.state", "source": "game", "eq": "ready"}},
    {"step": "assert", "until": {"path": "state.quests.sunk_ward:q_a1_m4.state", "source": "game", "eq": "active"}},
    {"step": "shot", "name": "kiln_loaded"},
    {"step": "click", "id": "marker.world_map"},
    {"step": "wait", "until": {"path": "screen", "eq": "world_map"}, "timeout_ms": 30000},
    {"step": "click", "id": "node.sunk_ward.sluice_undercroft"},
    {"step": "click", "id": "world_map.travel"},
    {"step": "repeat", "times": 10, "until": {"all": [{"path": "screen", "eq": "world_map"}, {"path": "state.location_id", "source": "game", "eq": "sunk_ward:sluice_undercroft"}]}, "steps": [
      {"step": "pause", "ms": 2000},
      {"step": "repeat", "times": 1, "until": {"path": "screen", "ne": "battle"}, "steps": [
        {"step": "wait", "until": {"path": "state.beat", "absent": true}, "timeout_ms": 10000},
        {"step": "link", "body": {"cmd": "autoplay"}},
        {"step": "repeat", "times": 10, "until": {"path": "screen", "eq": "battle_results"}, "steps": [{"step": "pause", "ms": 400}, {"step": "key", "key": "enter"}]},
        {"step": "click", "id": "results.continue"},
        {"step": "wait", "until": {"path": "screen", "ne": "battle_results"}, "timeout_ms": 10000}
      ]}
    ]},
    {"step": "click", "id": "world_map.enter"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 30000},
    {"step": "wait", "until": {"path": "state.location", "eq": "sunk_ward:sluice_undercroft"}, "timeout_ms": 30000},
    {"step": "click", "id": "marker.talia"},
    {"step": "wait", "until": {"all": [{"path": "state.walking", "eq": false}, {"path": "state.dialogue.speaker_name", "eq": "Talia Rusk"}]}, "timeout_ms": 30000},
    {"step": "assert", "until": {"path": "state.dialogue.choices.3.service", "eq": "turn_in"}},
    {"step": "shot", "name": "talia_turn_in"},
    {"step": "click", "id": "choice.3"},
    {"step": "wait", "until": {"path": "state.turn_in.quest", "eq": "sunk_ward:q_a1_m3"}},
    {"step": "shot", "name": "turn_in_pane"},
    {"step": "click", "id": "turn_in.confirm"},
    {"step": "wait", "until": {"path": "state.quests.sunk_ward:q_a1_m3.state", "source": "game", "eq": "completed"}},
    {"step": "shot", "name": "turned_in"}
  ]
}
