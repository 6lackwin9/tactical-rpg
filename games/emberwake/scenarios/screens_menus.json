{
  "id": "screens_menus",
  "title": "PR7-4: the menu screens as shots (golden once the baselines are approved): main menu, new game, load, the settings tabs and the Scene Runner",
  "settings": {"reduce_motion": true},
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "shot", "name": "main_menu"},
    {"step": "perf", "name": "main_menu", "frames": 60, "warm": 10},
    {"step": "click", "id": "menu.new_game"},
    {"step": "wait", "until": {"widget": "new_game.start"}},
    {"step": "shot", "name": "new_game"},
    {"step": "back"},
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.load"},
    {"step": "wait", "until": {"path": "screen", "eq": "load_slots"}},
    {"step": "shot", "name": "load_slots"},
    {"step": "back"},
    {"step": "click", "id": "menu.settings"},
    {"step": "wait", "until": {"path": "screen", "eq": "settings"}},
    {"step": "shot", "name": "settings_display"},
    {"step": "click", "id": "settings.tab.sound"},
    {"step": "shot", "name": "settings_sound"},
    {"step": "click", "id": "settings.tab.gameplay"},
    {"step": "shot", "name": "settings_gameplay"},
    {"step": "click", "id": "settings.tab.battle"},
    {"step": "shot", "name": "settings_battle"},
    {"step": "click", "id": "settings.tab.controls"},
    {"step": "shot", "name": "settings_controls"},
    {"step": "back"},
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.tools"},
    {"step": "wait", "until": {"path": "screen", "eq": "scene_runner"}},
    {"step": "shot", "name": "scene_runner"}
  ]
}
