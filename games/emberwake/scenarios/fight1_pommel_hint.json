{
  "id": "fight1_pommel_hint",
  "title": "PR7-41 (PT-21): a new game's first fight; the untouched auto plan's quick Pommel Strike breaks a Castellan Footman's Heavy Thrust before it lands (round 1 log)",
  "settings": {"reduce_motion": true},
  "timeout_s": 600,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.new_game"},
    {"step": "wait", "until": {"widget": "world.sunk_ward"}},
    {"step": "click", "id": "world.sunk_ward"},
    {"step": "click", "id": "new_game.start"},
    {"step": "wait", "until": {"path": "screen", "eq": "vignette"}, "timeout_ms": 20000},
    {"step": "repeat", "times": 40, "until": {"path": "screen", "ne": "vignette"}, "steps": [{"step": "key", "key": "space"}]},
    {"step": "wait", "until": {"path": "screen", "eq": "battle"}, "timeout_ms": 20000},
    {"step": "wait", "until": {"path": "state.beat", "absent": true}, "timeout_ms": 10000},
    {"step": "shot", "name": "fight1_planning"},
    {"step": "click", "id": "strip.confirm"},
    {"step": "wait", "until": {"path": "state.playing", "eq": true}, "timeout_ms": 5000},
    {"step": "wait", "until": {"path": "state.playing", "eq": false}, "timeout_ms": 120000},
    {"step": "click", "id": "bar.log"},
    {"step": "shot", "name": "fight1_round1_log"}
  ]
}
