{
  "id": "controls_rebind",
  "title": "PR7-44 (CONTROLS-UI1): the Settings Controls tab through the link: every action with its key and pad button, a click then a key rebinds, Esc cancels, a clash asks and Swap trades, a pad button an action cannot trade for is refused, two pad buttons swap, Reset to defaults drops the map",
  "settings": {"reduce_motion": true},
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.settings"},
    {"step": "wait", "until": {"path": "screen", "eq": "settings"}},
    {"step": "click", "id": "settings.tab.controls"},
    {"step": "wait", "until": {"widget": "settings_controls.f_bindings.0"}},
    {"step": "assert", "until": {"path": "state.rebind.step", "eq": "idle"}},
    {"step": "shot", "name": "controls_tab"},
    {"step": "audit", "scales": [1.0, 1.3]},
    {"step": "click", "id": "settings_controls.f_bindings.11"},
    {"step": "assert", "until": {"path": "state.rebind.action", "eq": "walk_up"}},
    {"step": "shot", "name": "controls_waiting"},
    {"step": "key", "key": "k"},
    {"step": "assert", "until": {"path": "state.settings.controls.keys.k", "eq": "w"}},
    {"step": "assert", "until": {"path": "state.rebind.step", "eq": "idle"}},
    {"step": "click", "id": "settings_controls.f_bindings.11"},
    {"step": "key", "key": "esc"},
    {"step": "assert", "until": {"path": "state.rebind.step", "eq": "idle"}},
    {"step": "assert", "until": {"path": "screen", "eq": "settings"}},
    {"step": "assert", "until": {"path": "state.settings.controls.keys.k", "eq": "w"}},
    {"step": "click", "id": "settings_controls.f_bindings.11"},
    {"step": "key", "key": "z"},
    {"step": "assert", "until": {"path": "state.rebind.step", "eq": "clash"}},
    {"step": "assert", "until": {"path": "state.rebind.with", "eq": "undo"}},
    {"step": "shot", "name": "controls_clash"},
    {"step": "audit", "scales": [1.0, 1.3]},
    {"step": "click", "id": "settings_controls.swap"},
    {"step": "assert", "until": {"path": "state.settings.controls.keys.z", "eq": "w"}},
    {"step": "assert", "until": {"path": "state.settings.controls.keys.k", "eq": "z"}},
    {"step": "click", "id": "settings_controls.f_bindings.21"},
    {"step": "link", "body": {"cmd": "pad", "button": "north"}},
    {"step": "assert", "until": {"path": "state.rebind.refused", "eq": "focus_next"}},
    {"step": "assert", "until": {"path": "state.settings.controls.pad.north", "eq": "tab"}},
    {"step": "shot", "name": "controls_refused"},
    {"step": "audit", "scales": [1.0, 1.3]},
    {"step": "key", "key": "esc"},
    {"step": "assert", "until": {"path": "state.rebind.step", "eq": "idle"}},
    {"step": "click", "id": "settings_controls.f_bindings.0"},
    {"step": "link", "body": {"cmd": "pad", "button": "east"}},
    {"step": "assert", "until": {"path": "state.rebind.with", "eq": "back"}},
    {"step": "key", "key": "enter"},
    {"step": "assert", "until": {"path": "state.settings.controls.pad.east", "eq": "enter"}},
    {"step": "assert", "until": {"path": "state.settings.controls.pad.south", "eq": "esc"}},
    {"step": "assert", "until": {"path": "state.rebind.step", "eq": "idle"}},
    {"step": "shot", "name": "controls_rebound"},
    {"step": "click", "id": "settings_controls.reset"},
    {"step": "assert", "until": {"path": "state.settings.controls", "absent": true}},
    {"step": "assert", "until": {"path": "state.rebind.step", "eq": "idle"}},
    {"step": "shot", "name": "controls_reset"}
  ]
}
