{
  "id": "sweep_telegraph",
  "title": "PR7-41 (PT-17, PT-20): the playtest save sweep_start enters The Sweep; the enemy area tiles mark where each area lands, and with Vesper selected the Footman's card names the block its Heavy Thrust lands (not its move's)",
  "launch": {"save": "sweep_start"},
  "settings": {"reduce_motion": true},
  "timeout_s": 600,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 20000},
    {"step": "repeat", "times": 4, "until": {"path": "screen", "eq": "battle"}, "steps": [
      {"step": "click", "id": "here.sweep"},
      {"step": "pause", "ms": 1500}
    ]},
    {"step": "wait", "until": {"path": "screen", "eq": "battle"}, "timeout_ms": 40000},
    {"step": "wait", "until": {"path": "state.beat", "absent": true}, "timeout_ms": 20000},
    {"step": "click", "id": "dialogue.continue"},
    {"step": "pause", "ms": 800},
    {"step": "click", "id": "party.1"},
    {"step": "hover", "id": "foe.5"},
    {"step": "shot", "name": "sweep_forecast_vesper"},
    {"step": "click", "id": "strip.confirm"},
    {"step": "wait", "until": {"path": "state.playing", "eq": true}, "timeout_ms": 5000},
    {"step": "wait", "until": {"path": "state.playing", "eq": false}, "timeout_ms": 120000},
    {"step": "click", "id": "strip.confirm"},
    {"step": "pause", "ms": 2500},
    {"step": "hover", "id": "foe.4"},
    {"step": "shot", "name": "sweep_round2_area_marks"}
  ]
}
