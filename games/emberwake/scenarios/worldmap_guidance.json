{
  "id": "worldmap_guidance",
  "title": "PR7-37 (PT-08, PT-31): the playtest save hub_start; on the world map Alleyway Junction 7 (no road from the hub) names the next step there (travel to the Drowned Runoff Grate, enter it and take its exit), and the legend lists the active quests",
  "launch": {"save": "hub_start"},
  "settings": {"reduce_motion": true},
  "timeout_s": 300,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 20000},
    {"step": "pause", "ms": 800},
    {"step": "repeat", "times": 3, "until": {"path": "screen", "eq": "world_map"}, "steps": [
      {"step": "click", "id": "marker.road"},
      {"step": "pause", "ms": 4000}
    ]},
    {"step": "wait", "until": {"path": "screen", "eq": "world_map"}, "timeout_ms": 20000},
    {"step": "pause", "ms": 1000},
    {"step": "click", "id": "node.sunk_ward.alleyway_junction_7"},
    {"step": "pause", "ms": 800},
    {"step": "assert", "until": {"widget": "world_map.way_hint"}},
    {"step": "shot", "name": "worldmap_way_hint"}
  ]
}
