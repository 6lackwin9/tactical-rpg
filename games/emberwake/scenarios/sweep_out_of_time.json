{
  "id": "sweep_out_of_time",
  "title": "PR7-37 (PT-02, PT-24): the playtest save sweep_start fights The Sweep by the link's autoplay to its round limit; the banner and the results read Out of time (not Fled), the results say the job is still open and can be tried again, and the hub log keeps that line",
  "launch": {"save": "sweep_start"},
  "settings": {"reduce_motion": true},
  "timeout_s": 600,
  "steps": [
    {"step": "wait", "until": {"path": "screen", "eq": "main_menu"}},
    {"step": "click", "id": "menu.continue"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 20000},
    {"step": "repeat", "times": 4, "until": {"path": "screen", "eq": "battle"}, "steps": [
      {"step": "click", "id": "here.sweep"},
      {"step": "pause", "ms": 1500}
    ]},
    {"step": "wait", "until": {"path": "screen", "eq": "battle"}, "timeout_ms": 40000},
    {"step": "wait", "until": {"path": "state.beat", "absent": true}, "timeout_ms": 20000},
    {"step": "click", "id": "dialogue.continue"},
    {"step": "pause", "ms": 800},
    {"step": "link", "body": {"cmd": "autoplay"}},
    {"step": "wait", "until": {"path": "state.outcome", "ne": ""}, "timeout_ms": 240000},
    {"step": "pause", "ms": 800},
    {"step": "assert", "until": {"path": "state.timed_out", "eq": true}},
    {"step": "shot", "name": "sweep_banner_out_of_time"},
    {"step": "repeat", "times": 8, "until": {"path": "screen", "eq": "battle_results"}, "steps": [
      {"step": "key", "key": "enter"},
      {"step": "pause", "ms": 800}
    ]},
    {"step": "wait", "until": {"path": "screen", "eq": "battle_results"}, "timeout_ms": 20000},
    {"step": "pause", "ms": 1200},
    {"step": "assert", "until": {"path": "state.head", "eq": "Out of time"}},
    {"step": "shot", "name": "sweep_results_out_of_time"},
    {"step": "key", "key": "enter"},
    {"step": "wait", "until": {"path": "screen", "eq": "region_map"}, "timeout_ms": 20000},
    {"step": "pause", "ms": 1500},
    {"step": "shot", "name": "sweep_hub_log"}
  ]
}
