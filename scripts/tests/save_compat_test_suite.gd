class_name SaveCompatTestSuite
extends RefCounted

# ==============================================================================
# Tactical RPG - Save compatibility test suite (SAVE-COMPAT, S13)
# One committed sample save per version 1..SaveGame.VERSION (scripts/tests/fixtures/saves/save_v<n>.json, regenerated by
# tools/gen_save_fixtures.gd) goes through SaveGame.decode (the path read() uses: parse, migrate, validate) against the
# shipped catalog and worlds. Bumping SaveGame.VERSION without adding a fixture fails here.
# ==============================================================================

const TAG: String = "SaveCompat"
const FIXTURE_DIR: String = "res://scripts/tests/fixtures/saves"

static func fixture_path(version: int) -> String:
	return "%s/save_v%d.json" % [FIXTURE_DIR, version]

static func run() -> bool:
	print("\n=======================================================")
	print("=== STARTING SAVE COMPAT TEST (SAVE-COMPAT)          ===")
	print("=======================================================")
	ContentCatalog.use_root(ContentCatalog.DEFAULT_ROOT)
	WorldCatalog.use_root(WorldCatalog.DEFAULT_ROOT)
	SaveMigrations.reset()
	var ok: bool = true
	var present: Dictionary = {}
	for version: int in range(1, SaveGame.VERSION + 1):
		present["fixture for v%d" % version] = FileAccess.file_exists(fixture_path(version))
	ok = TestHelpers.report(TAG, "one fixture per version", present) and ok
	for version: int in range(1, SaveGame.VERSION + 1):
		if FileAccess.file_exists(fixture_path(version)):
			ok = _check_version(version) and ok
	return ok

static func _check_version(version: int) -> bool:
	var text: String = FileAccess.get_file_as_string(fixture_path(version))
	var json := JSON.new()
	var parsed: bool = json.parse(text) == OK and json.data is Dictionary
	var envelope: Dictionary = DictUtil.dict_of(json.data) if parsed else {}
	var checks: Dictionary = {"parses": parsed, "envelope_version": DictUtil.to_int(envelope.get("version", 0)) == version}
	var res: Dictionary = SaveGame.decode(text)
	checks["no errors"] = DictUtil.to_bool(res["ok"]) and DictUtil.array_of(res["errors"]).is_empty()
	if not DictUtil.to_bool(res["ok"]):
		print("  decode errors: %s" % str(res["errors"]))
	var g: GameState = GameState.of(res["state"])
	checks["state loaded"] = g != null
	if g != null:
		checks["valid"] = g.validate().is_empty()
		checks["world"] = g.world_id == "ashlands"
		checks["party size"] = g.party.members.size() >= 2
		checks["item survives"] = g.party.members[0].carried.has("con_heal_potion") and g.party.stash.has("con_heal_potion")
		checks["flag survives"] = g.has_flag("intro.done")
		checks["location qualified"] = g.location_id == "ashlands:warden_keep"
		if version >= 2:
			checks["quest states"] = DictUtil.dict_of(g.quests.get("ashlands:hold_the_courtyard", {})).get("state", "") == "active" and DictUtil.dict_of(g.quests.get("ashlands:done_quest", {})).get("state", "") == "completed"
			checks["loot_claimed"] = g.loot_claimed.has("ashlands:wardens_drill")
		else:
			checks["loot_claimed defaulted"] = g.loot_claimed.is_empty()
		if version >= 4:
			checks["gold"] = g.party.gold == 75
			checks["shops"] = g.shops.has("ashlands:hest_stores")
		else:
			checks["gold defaulted"] = g.party.gold == 0 and g.shops.is_empty()
		if version >= 3:
			checks["exploration"] = g.position == Vector2i(2, 3) and DictUtil.to_int(g.explore["steps"]) == 9
		if version >= 5:
			checks["world clock"] = g.time == 240
		else:
			checks["clock defaulted"] = g.time == 0
		if version >= 7:
			var heroes: Dictionary = DictUtil.dict_of(g.autoplay.get("heroes", {}))
			checks["autoplay"] = DictUtil.to_bool(g.autoplay.get("on", false)) and str(g.autoplay.get("party", "")) == "aggressive" and heroes.size() == 2 and heroes.values().has(PlanPresets.CUSTOM)
		else:
			checks["autoplay migrated off"] = JsonUtil.deep_equal(g.autoplay, GameState.default_autoplay())   # AUTO1-L: v6 -> v7
		if version >= 8:
			checks["pouch"] = not g.party.members[0].pouch.is_empty()
		else:
			var empty: bool = true
			for m: UnitState in g.party.members:
				empty = empty and m.pouch.is_empty()
			checks["pouch migrated empty"] = empty   # ITEMUSE1-L: v7 -> v8
		var lost: Array[int] = []
		for m: UnitState in g.party.members:
			lost.append(m.hp_lost)
		if version >= 9:
			checks["hp_lost and last_rest"] = lost.has(37) and str(g.explore.get("last_rest", "")) == "ashlands:warden_keep"
		else:
			checks["hp_lost 0 and last_rest empty"] = lost.max() == 0 and lost.min() == 0 and str(g.explore.get("last_rest", "x")).is_empty()   # HEAL1-L: v8 -> v9
		if version >= 10:
			checks["purses"] = DictUtil.to_int(g.purses.get("ashlands:courtyard_skirmish", 0)) == 1
		else:
			checks["purses migrated empty"] = g.purses.is_empty()   # PURSE1-L: v9 -> v10
		if version >= 6:
			checks["supplies"] = g.party.supplies == 7
			var again: Dictionary = SaveGame.decode(JSON.stringify({"format": SaveGame.FORMAT, "version": SaveGame.VERSION, "saved_at": 1, "game_state": g.to_dict()}))
			checks["round-trips"] = DictUtil.to_bool(again["ok"]) and g.equals(GameState.of(again["state"]))
		else:
			checks["supplies migrated"] = g.party.supplies == PartyState.SUPPLIES_START   # TRAV2-L: v5 -> v6
	var migrated: Dictionary = SaveMigrations.migrate(envelope)
	checks["migrated to current"] = DictUtil.dict_of(migrated["data"]).get("version", 0) == SaveGame.VERSION
	return TestHelpers.report(TAG, "save_v%d" % version, checks)
